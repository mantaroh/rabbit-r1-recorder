<?xml version="1.0" encoding="utf-8"?>
<!--
  The side button never reaches an ordinary app: the CarrotOS launcher grabs it
  from an AccessibilityService of its own (`com.r1.launcher/.PowerService`,
  logging as R1Power), so it arrives before any window focus is consulted and
  works with the screen off.

  Key filtering is the only documented way for a second app to see the same
  events. This service consumes nothing — it returns false from onKeyEvent so
  the launcher's own handling is untouched.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:notificationTimeout="100"
    android:description="@string/key_service_description" />
