<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Segments are uploaded to the lifelog Worker. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Handing a spoken question to the chat client. -->
    <uses-permission android:name="com.r1.hermes.permission.ASK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Timelapse frames from the motorised arm; see Timelapse.kt. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <!-- Photographs are confined to one Wi-Fi. Reading which network the
         device is on needs the location permission from Android 10 onward,
         even though nothing here wants a position. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Android 12 onward refuses a fine-location request that does not also
         ask for coarse, even when only fine is wanted. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Position fixes continue while the app is not in front; the recorder is
         already a foreground service, so this adds a type rather than a
         service. There is no network location on this device — see
         Positions.kt — so this is the GPS receiver and nothing else. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Recording has to resume by itself after a reboot; see BootReceiver. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Under test: whether the audio path survives screen-off without it. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Confirms the gesture when the screen is dark. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".ProbeApp"
        android:allowBackup="false"
        android:label="R1 Audio Probe"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Also a home screen, so the device comes back here rather than
                 to the stock launcher and the standby display is what it shows
                 when left alone.

                 Not exclusive: CarrotOS's launcher stays installed and can be
                 chosen again, which matters because it owns the side button
                 through an accessibility service. That service is independent
                 of which app is home, but it has never been tested with a
                 different one in front. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>

        <!-- Everything the home screen deliberately does not show: the upload
             target, the codec, the capture source. Reached from 設定 and left
             by 戻る, since the R1 has no Back key. -->
        <activity
            android:name=".SettingsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Started from the visible Activity: Android 14 restricts starting a
             microphone FGS from the background. -->
        <service
            android:name=".RecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera|location" />

        <!-- The chat client, compiled from :hermes's sources (see
             build.gradle.kts). Not exported: the recorder now hands a spoken
             question straight to it in-process, so the cross-app permission
             the standalone version needs has no job here. -->
        <activity
            android:name="com.r1.hermes.ChatActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.r1.hermes.SessionsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Photo attachments for a chat message. -->
        <activity
            android:name="com.r1.hermes.CaptureActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Gateway URL and token. Kept because the merged app otherwise has
             no way to configure the chat it now contains. -->
        <activity
            android:name="com.r1.hermes.MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Reachable from the screen above, so it has to be declared: an
             undeclared Activity is a crash the moment somebody taps it. -->
        <activity
            android:name="com.r1.hermes.ProbeActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- The standby display. Not exported and not in recents: it is a
             state the device falls into, not a screen anyone navigates to. -->
        <activity
            android:name=".SignageActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <!-- The 23:00 question. Wakes the screen because it fires while the
             device is asleep on a table, and is often read from a distance. -->
        <activity
            android:name=".StopPromptActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:showOnLockScreen="true"
            android:turnScreenOn="true" />

        <!-- Shown the instant the gesture arms, since the press itself dims
             the screen and otherwise nothing acknowledges it. -->
        <activity
            android:name=".QueryActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:showOnLockScreen="true"
            android:turnScreenOn="true" />

        <!-- Direct boot aware so it also fires before the user unlocks: this
             device reboots unattended and nobody is there to unlock it. -->
        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- The only way to observe the side button; see KeyService. -->
        <service
            android:name=".KeyService"
            android:exported="true"
            android:label="R1 side button"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/key_service" />
        </service>

    </application>

</manifest>
