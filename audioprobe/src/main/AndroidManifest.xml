<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Segments are uploaded to the lifelog Worker. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Handing a spoken question to the chat client. -->
    <uses-permission android:name="com.r1.hermes.permission.ASK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Recording has to resume by itself after a reboot; see BootReceiver. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Under test: whether the audio path survives screen-off without it. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Confirms the gesture when the screen is dark. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:label="R1 Audio Probe"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:screenOrientation="portrait">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Started from the visible Activity: Android 14 restricts starting a
             microphone FGS from the background. -->
        <service
            android:name=".RecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Shown the instant the gesture arms, since the press itself dims
             the screen and otherwise nothing acknowledges it. -->
        <activity
            android:name=".QueryActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:showOnLockScreen="true"
            android:turnScreenOn="true" />

        <!-- Direct boot aware so it also fires before the user unlocks: this
             device reboots unattended and nobody is there to unlock it. -->
        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- The only way to observe the side button; see KeyService. -->
        <service
            android:name=".KeyService"
            android:exported="true"
            android:label="R1 side button"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/key_service" />
        </service>

    </application>

</manifest>
