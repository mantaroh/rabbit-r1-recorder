<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Segments are uploaded to the lifelog Worker. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Handing a spoken question to the chat client. -->
    <uses-permission android:name="com.r1.hermes.permission.ASK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Under test: whether the audio path survives screen-off without it. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:label="R1 Audio Probe"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:screenOrientation="portrait">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Started from the visible Activity: Android 14 restricts starting a
             microphone FGS from the background. -->
        <service
            android:name=".RecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- The only way to observe the side button; see KeyService. -->
        <service
            android:name=".KeyService"
            android:exported="true"
            android:label="R1 side button"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/key_service" />
        </service>

    </application>

</manifest>
